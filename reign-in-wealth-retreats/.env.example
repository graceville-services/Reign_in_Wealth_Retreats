# Copying is optional: npm run setup generates this file and secure local credentials.
APP_URL=http://localhost:3000
# Exact additional trusted HTTPS origins for Codespaces/preview environments.
# Use a comma-separated list of origins (no trailing slash, paths, or wildcard).
# E.g. https://YOUR-CODESPACE-3000.app.github.dev
APP_ALLOWED_ORIGINS=
DATABASE_PATH=./data/retreats.sqlite
MEDIA_PATH=./data/media

# Local preview links are permitted only when NODE_ENV is not production.
DEV_PREVIEW_MODE=true
ADMIN_EMAIL=admin@reigninwealth.local
ADMIN_PASSWORD_HASH=
CRON_SECRET=

# Stripe Checkout. Use test keys before launch; never place these in client variables.
# Required webhook events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.expired, charge.refunded. Endpoint: /api/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend: use a verified sender domain. With empty values emails stay in the admin outbox.
RESEND_API_KEY=
EMAIL_FROM=

BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
