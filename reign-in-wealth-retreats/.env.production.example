# Production template for reigninwealthretreats.com (SQLite / cPanel Passenger).
# Generate .env and unique credentials with:
# npm run setup:production -- --admin-email you@your-domain.com --apply
# Never commit the generated .env. This example contains no live credentials.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
APP_URL=https://reigninwealthretreats.com
APP_ALLOWED_ORIGINS=https://www.reigninwealthretreats.com
DEV_PREVIEW_MODE=false
DEBUG_ORIGIN=false

# Relative paths resolve from the application directory. The production setup
# command creates absolute defaults; it preserves paths from an existing .env.
DATABASE_PATH=./data/retreats.sqlite
MEDIA_PATH=./data/media
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# The setup command requires your controlled email and generates these secrets.
# Existing credentials are preserved unless you change them deliberately.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
CRON_SECRET=

# Optional until payments are enabled. Obtain these from your Stripe account.
# Production payments require sk_live_... and whsec_... values.
# Webhook URL: https://reigninwealthretreats.com/api/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required for delivery of traveler login links and outgoing email.
# Use a Resend key and a sender on a domain verified in your Resend account.
# Example EMAIL_FROM format: Reign in Wealth Retreats <hello@your-domain.com>
RESEND_API_KEY=
EMAIL_FROM=
